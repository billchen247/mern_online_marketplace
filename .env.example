# Copy to .env (never commit .env)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mern_online_marketplace?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_URL=http://localhost:5173
# Comma-separated extra allowed origins
CORS_EXTRA_ORIGINS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
# Required only for `npm run seed -- --reset` (drops the database!)
ALLOW_SEED=false
